NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=node_boilerplate_psql
HOST=0.0.0.0
PORT=3000
SHUTDOWN_TIMEOUT_MS=10000

# Required in production
# API_TOKEN=

# Database
# Host `db` is the compose service name. Use 127.0.0.1 when the app runs on the
# host and Postgres is exposed by compose.
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/app
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
# Set to true for managed Postgres (RDS, Neon, Supabase) that requires TLS.
DATABASE_SSL=false
# false lets the process boot without a reachable database. /health then
# reports "degraded" instead of failing.
DB_REQUIRED=true

# Used by the `db` service in docker-compose.yml to build DATABASE_URL.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
