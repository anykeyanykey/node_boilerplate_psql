{
  "name": "node_boilerplate_psql",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js + TypeScript boilerplate",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "commit:lint": "commitlint",
    "commit:lint:file": "commitlint --edit",
    "clean": "rimraf dist coverage",
    "prepare": "husky",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:dev": "pm2 start ecosystem.config.cjs --env development",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --update-env",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "pm2:flush": "pm2 flush",
    "pm2:kill": "pm2 kill",
    "docker:build": "docker build -t node_boilerplate_psql:local .",
    "docker:run": "docker run --rm --env-file .env -p 3000:3000 node_boilerplate_psql:local"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,cts,mts}": [
      "prettier --write --cache --cache-strategy content",
      "eslint --fix --cache --cache-strategy content"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write --cache --cache-strategy content"
    ],
    "Dockerfile": []
  },
  "dependencies": {
    "pino": "^10.3.1",
    "pm2": "^7.0.4",
    "zod": "^4.6.5"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
